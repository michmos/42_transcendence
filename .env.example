# Frontend ports and URLs
VITE_PORT=5173
API_URL=http://localhost:${VITE_PORT}/api
SOCKET_URL=ws://localhost:${VITE_PORT}/websocket

# Internal service ports and URLs
SOCKET_PORT=3001
API_PORT=3002
SWAGGER_PORT=3003

API_SERVER=http://localhost:${API_PORT}
SOCKET_SERVER=http://localhost:${SOCKET_PORT}
SWAGGER_SERVER=http://localhost:${SWAGGER_PORT}

REDIRECT_URL=${API_URL}/auth/callback

ADMIN_API_KEY=exampleapikey
JWT_SECRET=examplesecretkey

# Database container
DATABASE_URL=file:./dev.db

# API Server OAuth credentials

# Urls for docker deployment
CORS_URL=https://transcendence.clusterfuck.cloud
VITE_SOCKET_URL=wss://transcendence.clusterfuck.cloud/websocket


# Internal service URLs for docker deployment
API_SERVER=http://fastify-api:3000
SOCKET_SERVER=http://fastify-socket:3000

# Secret keys
ADMIN_API_KEY=CHANGE_ME_IN_PRODUCTION
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_IN_PRODUCTION

# Database container
DATABASE_URL=file:./dev.db

# API Server OAuth credentials
GOOGLE_CLIENT_ID=thisisnotarealclientid
GOOGLE_CLIENT_SECRET=thisisnotarealclientsecret

FORTYTWO_CLIENT_ID=thisisnotarealclientid
FORTYTWO_CLIENT_SECRET=thisisnotarealclientsecret

GITHUB_CLIENT_ID=thisisnotarealclientid
GITHUB_CLIENT_SECRET=thisisnotarealclientsecret

REDIRECT_URL=${API_URL}/auth/callback

#TODO NO CDN PORT!!!
CDN_PORT=3008
CDN_PATH=/path/to/transcendence

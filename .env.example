# Frontend ports and URLs
PORT=5173

FRONTEND_URL=http://localhost:${PORT}

VITE_API_URL=${FRONTEND_URL}/api
API_URL=${FRONTEND_URL}/api

VITE_SOCKET_URL=ws://localhost:5173/websocket
SOCKET_URL=ws://localhost:${VITE_PORT}/websocket

# Internal service ports and URLs
SOCKET_PORT=3001
API_PORT=3002
SWAGGER_PORT=3003

API_SERVER=http://localhost:${API_PORT}
SOCKET_SERVER=http://localhost:${SOCKET_PORT}
SWAGGER_SERVER=http://localhost:${SWAGGER_PORT}

ADMIN_API_KEY=CHANGE_ME_IN_PRODUCTION
JWT_SECRET=CHANGE_ME_IN_PRODUCTION

# Database container
DATABASE_URL=file:./dev.db

# API Server OAuth credentials
GOOGLE_CLIENT_ID=thisisnotarealclientid
GOOGLE_CLIENT_SECRET=thisisnotarealclientsecret

FORTYTWO_CLIENT_ID=thisisnotarealclientid
FORTYTWO_CLIENT_SECRET=thisisnotarealclientsecret

GITHUB_CLIENT_ID=thisisnotarealclientid
GITHUB_CLIENT_SECRET=thisisnotarealclientsecret

REDIRECT_URL=${API_URL}/auth/callback

# Frontend port and URL
PORT=5173
CORS_URL="https://transcendence.clusterfuck.cloud/"
CORS_URL=http://localhost:${PORT}/
# CORS_URL=https://localhost:8443/
# Paths
DATABASE_URL=file:/tmp/db/db.sqlite
CDN_PATH=/tmp/cdn
# Internal service URLs and ports for docker deployment
# API_PORT=3000
# API_SERVER=http://api:${API_PORT}/
# SOCKET_PORT=3001
# SOCKET_SERVER=http://socket:${SOCKET_PORT}/
# CDN_PORT=3002
# CDN_SERVER=http://cdn:${CDN_PORT}/
# Secret keys
ADMIN_API_KEY=CHANGE_ME_IN_PRODUCTION
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_IN_PRODUCTION
# API Server OAuth credentials
GOOGLE_CLIENT_ID=thisisnotarealclientid
GOOGLE_CLIENT_SECRET=thisisnotarealclientid
FORTYTWO_CLIENT_ID=thisisnotarealclientid
FORTYTWO_CLIENT_SECRET=thisisnotarealclientid
GITHUB_CLIENT_ID=thisisnotarealclientid
GITHUB_CLIENT_SECRET=thisisnotarealclientid
# OAuth redirect URL
REDIRECT_URL=${CORS_URL}api/auth/callback
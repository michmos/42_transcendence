{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": [".env"],
	"tasks": {
		"db:generate": {
			"inputs" : ["$TURBO_DEFAULT$"],
			"env": ["DATABASE_URL"],
			"cache": true
		},
		"db:push": {
			"inputs" : ["$TURBO_DEFAULT$"],
			"env": ["DATABASE_URL"],
			"cache": true
		},
		"db:studio": {
			"env": ["DATABASE_URL"]
		},
		"build": {
			"dependsOn": ["^db:generate"],
			"inputs": ["$TURBO_DEFAULT$"],
			"outputs": ["dist/**", "out/**"]
		},
		"dev": {
			"dependsOn": ["^db:generate", "^db:push"],
			"inputs": ["$TURBO_DEFAULT$"],
			"env": ["DATABASE_URL", "API_URL", "API_PORT", "SOCKET_URL", "SOCKET_PORT", "VITE_PORT", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "GOOGLE_REDIRECT_URL", "FRONTEND_URL", "JWT_SECRET"],
			"cache": false,
			"persistent": true
		},
		"docker": {
			"dependsOn": ["^build"]
		},
		"preview": {
			"dependsOn": ["build"],
			"inputs": ["$TURBO_DEFAULT$", ".env"],
			"env": ["DATABASE_URL", "API_URL", "API_PORT", "SOCKET_URL", "SOCKET_PORT", "VITE_PORT"],
			"cache": false,
			"persistent": true
		},
		"test": {
			"dependsOn": ["build"],
			"outputs": ["coverage/**"],
			"cache": false
		},
		"lint": {
			"inputs": ["src/**", "$TURBO_DEFAULT$", "eslint.config.mjs"],
			"cache": true
		},
		"lint:fix": {
			"inputs": ["src/**", "$TURBO_DEFAULT$", "eslint.config.mjs"],
			"cache": false
		}
	}
}

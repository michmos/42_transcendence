{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "VITE_PORT",
    "VITE_URL",
    "VITE_API_URL",
    "VITE_SOCKET_URL",
    "SOCKET_PORT",
    "API_PORT",
    "SWAGGER_PORT",
    "API_SERVER",
    "SOCKET_SERVER",
    "SWAGGER_SERVER",
    "ADMIN_API_KEY",
    "JWT_SECRET",
    "DATABASE_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "FORTYTWO_CLIENT_SECRET",
    "FORTYTWO_CLIENT_ID",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "REDIRECT_URL"
  ],
  "tasks": {
    "db:generate": {
      "inputs": ["$TURBO_DEFAULT$"],
      "env": ["DATABASE_URL"],
      "cache": false
    },
    "db:push": {
      "inputs": ["$TURBO_DEFAULT$"],
      "env": ["DATABASE_URL"],
      "cache": false
    },
    "db": {
      "dependsOn": ["db:generate", "db:push"]
    },

    "dep:build": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**", "out/**"],
      "cache": false
    },

    "app-base": {
      "dependsOn": ["^dep:build", "^db"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "./packages/**",
        "./plugins/**",
        "./apps/**",
        ".env"
      ],
      "cache": false
    },

    "build": {
      "dependsOn": ["^dep:build", "^db"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**", "out/**"],
      "cache": false
    },

    "docker": {
      "dependsOn": ["^build"]
    },

    "dev": {
      "dependsOn": ["app-base"],
      "persistent": true
    },

    "test": {
      "dependsOn": ["app-base"],
      "persistent": true
    },

    "test:watch": {
      "dependsOn": ["app-base"],
      "persistent": true
    },

    "preview": {
      "dependsOn": ["app-base", "build", "^db"],
      "persistent": true
    },

    "lint": {
      "inputs": ["src/**", "$TURBO_DEFAULT$", "eslint.config.mjs"],
      "cache": false
    },

    "lint:fix": {
      "inputs": ["src/**", "$TURBO_DEFAULT$", "eslint.config.mjs"],
      "cache": false
    }
  }
}

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum userRole {
  ADMIN
  MEMBER
}

enum status {
  OUTSTANDING
  ONGOING
  FINISHED
  CANCELED
}

enum groupType {
  FRIENDS
  GAME
  TOURNAMENT
}

model oAuthProvider {
  // Meta
  uuid              String   @id @default(uuid())
  provider          String   // google, github, etc.

  // Data
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  userId            String

  // Relations
  user              User     @relation(fields: [userId], references: [uuid])
}


model User {
  // Meta
  uuid              String    @id @default(uuid())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Authentication
  username          String
  email             String    @unique
  oAuthProviders    oAuthProvider[]

  // Profile
  avatar            String?
  role              userRole  @default(MEMBER)
  
  // Relations
  groups            Group[]   @relation("UserGroups")
  ownedGroups       Group[]   @relation("UserOwnedGroups")
}

model Tournament {
  // Meta
  uuid              String    @id @default(uuid())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tournamentName    String
  minPlayers        Int
  maxPlayers        Int
  playerCount       Int       @default(1)
  lockTime          Int       @default(10)
  gameTime          Int       @default(3)
  status            status    @default(OUTSTANDING)
  numberofRounds    Int?
  currentRound      Int       @default(0)

  // Relations
  participants      Group     @relation(fields: [groupId], references: [uuid])
  groupId           String    @unique
}

model Group {
  // Meta
  uuid        String      @id @default(uuid())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Data
  name        String?
  ownerId     String
  type        groupType   @default(FRIENDS)
  
  // Relations
  users       User[]      @relation("UserGroups")
  owner       User        @relation("UserOwnedGroups", fields: [ownerId], references: [uuid])
  tournament  Tournament?
}

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum userRole {
  ADMIN
  MEMBER
}

enum FriendshipState {
	FRIENDS
	REQUESTED
	BLOCKED
	DENIED
}

model oAuthProvider {
  // Meta
  uuid              String   @id @default(uuid())
  provider          String   // google, github, etc.

  // Data
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  userId            String

  // Relations
  user              User     @relation(fields: [userId], references: [uuid])
}


model User {
  // Meta
  uuid              String    @id @default(uuid())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Authentication
  username          String
  email             String    @unique
  oAuthProviders    oAuthProvider[]

  // Profile
  avatar            String?
  role              userRole  @default(MEMBER)
  
  // Relations
  friendsA			Friends[]	@relation(name: "friendsA")
  friendsB			Friends[]	@relation(name: "friendsB")
  
}

model Friends {
	// Meta
	uuid			String			@id @default(uuid())
	createdAt		DateTime		@default(now())			
	updatedAt		DateTime		@default(now())

	// Relations
	friendA			User 			@relation("friendsA", fields: [friendAId], references: [uuid])
	friendAId		String
	friendB			User 			@relation("friendsB", fields: [friendBId], references: [uuid])
	friendBId		String
	state			FriendshipState	@default(REQUESTED)
	
	@@unique([friendAId, friendBId])
	@@index(state)
}

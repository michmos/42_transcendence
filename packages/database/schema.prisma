generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----- ENUMS -----
enum userRole {
  ADMIN
  MEMBER
}

enum status {
  outstanding
  ongoing
  finished
  canceled
}

enum friendshipState {
  REQUESTED
  ACCEPTED
  REJECTED
}

// ----- MODELS -----
model User {
  // Meta
  uuid              String      @id @default(uuid())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Authentication
  email             String      @unique
  email_verified    Boolean     @default(false)
  
  // Profile
  avatar            String?
  fullName          String?
  nickname          String      @unique
  role              userRole    @default(MEMBER)

  // Games
  tournaments       Tournament[]
  matches1          Match[]    @relation("MatchesAsPlayer1")
  matches2          Match[]    @relation("MatchesAsPlayer2")

  // Statistics
  gamesPlayed       Int       @default(0)
  gamesWon          Int       @default(0)

  tournamentsPlayed Int       @default(0)
  tournamentsWon    Int       @default(0)

  // Relations / Friendships
  friendsA          Friendship[]  @relation(name: "friendsA")
  friendsB          Friendship[]  @relation(name: "friendsB")
}

model Friendship {
  // Meta
  uuid        String      @id @default(uuid())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  friendA     User        @relation("friendsA", fields: [friendAId], references: [uuid])
  friendAId   String
  friendB     User        @relation("friendsB", fields: [friendBId], references: [uuid])
  friendBId   String
  state       friendshipState @default(REQUESTED)

  @@unique([friendAId, friendBId])
  @@index(state)
}



// ----- GAME -----
model Tournament {
  // Meta
  uuid              String    @id @default(uuid())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tournamentName    String
  minPlayers        Int
  maxPlayers        Int
  playerCount       Int       @default(0)
  status            status    @default(outstanding)
  numberOfRounds    Int       @default(0)
  currentRound      Int       @default(0)

  // Relations
  participants      User[]
  rounds            TournamentRound[]
}

model TournamentRound {
  // Meta
  uuid          String    @id @default(uuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Data
  index         Int
  tournamentId  String
  status        status    @default(outstanding)

  // Relations
  matches       Match[]
  tournament    Tournament  @relation(fields: [tournamentId], references: [uuid], onDelete: Cascade)
}

model Match {
  // Meta
  uuid              String    @id @default(uuid())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Data
  status            status    @default(outstanding)
  Score1            Int       @default(0)
  Score2            Int       @default(0)
  player1Id         String?
  player2Id         String?
  winnerId          String?
  tournamentRoundId String?

  // Relations
  player1           User?  @relation("MatchesAsPlayer1", fields: [player1Id], references: [uuid])
  player2           User?  @relation("MatchesAsPlayer2", fields: [player2Id], references: [uuid])
  tournament        TournamentRound?  @relation(fields: [tournamentRoundId], references: [uuid], onDelete: SetNull)
}

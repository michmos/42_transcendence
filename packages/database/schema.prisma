generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}



// ----- ENUMS -----
enum userRole {
  ADMIN
  MEMBER
}

enum status {
  OUTSTANDING
  ONGOING
  FINISHED
  CANCELED
}

enum friendshipState {
	REQUESTED
	ACCEPTED
	DENIED
}



// ----- User management -----
model oAuthProvider {
  // Meta
  uuid              String   @id @default(uuid())
  provider          String   // google, github, etc.

  // Data
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  userId            String

  // Relations
  user              User     @relation(fields: [userId], references: [uuid])
}

model User {
  // Meta
  uuid              String      @id @default(uuid())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Authentication
  nickname          String      @unique
  email             String      @unique
  oAuthProviders    oAuthProvider[]

  // Profile
  avatar            String?
  twoFactorEnabled  Boolean     @default(false)
  twoFactorSecret   String?
  role              userRole    @default(MEMBER)

  // Games
  tournaments       Tournament[]
  matches1          Match[]    @relation("MatchesAsPlayer1")
  matches2          Match[]    @relation("MatchesAsPlayer2")

  // Statistics
  gamesPlayed       Int @default(0)
  gamesWon          Int @default(0)

  tournamentsPlayed Int @default(0)
  tournamentsWon    Int @default(0)

  // Relations / Friendships
  friendsA		    Friends[]	@relation(name: "friendsA")
  friendsB		   	Friends[]	@relation(name: "friendsB")
}

model Friends {
	// Meta
	uuid			  String			@id @default(uuid())
	createdAt		DateTime		@default(now())
	updatedAt		DateTime		@updatedAt

	// Relations
	friendA			User 			@relation("friendsA", fields: [friendAId], references: [uuid])
	friendAId		String
	friendB			User 			@relation("friendsB", fields: [friendBId], references: [uuid])
	friendBId		String
	state			friendshipState	@default(REQUESTED)

	@@unique([friendAId, friendBId])
	@@index(state)
}



// ----- GAME -----
model Tournament {
  // Meta
  uuid              String    @id @default(uuid())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tournamentName    String
  minPlayers        Int
  maxPlayers        Int
  playerCount       Int       @default(1)
  lockTime          Int       @default(10)
  gameTime          Int       @default(3)
  status            status    @default(OUTSTANDING)
  numberOfRounds    Int       @default(1)
  currentRound      Int       @default(0)

  // Relations
  participants      User[]
  rounds            TournamentRound[]
}

model TournamentRound {
  // Meta
  uuid          String    @id @default(uuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Data
  index         Int
  tournamentId  String

  // Relations
  matches       Match[]
  tournament    Tournament  @relation(fields: [tournamentId], references: [uuid], onDelete: Cascade)
}

model Match {
  // Meta
  uuid              String    @id @default(uuid())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Data
  status            status    @default(OUTSTANDING)
  Score1            Int       @default(0)
  Score2            Int       @default(0)
  player1Id         String?
  player2Id         String?
  winnerId          String?
  tournamentRoundId String?

  // Relations
  player1           User?  @relation("MatchesAsPlayer1", fields: [player1Id], references: [uuid])
  player2           User?  @relation("MatchesAsPlayer2", fields: [player2Id], references: [uuid])
  tournament        TournamentRound?  @relation(fields: [tournamentRoundId], references: [uuid], onDelete: SetNull)
}
